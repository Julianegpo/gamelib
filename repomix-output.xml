        </div>
      </nav>
    </header>
    <main class="max-w-5xl mx-auto w-full flex-1 flex flex-col p-4">
      <div class="my-auto w-full">
        <slot />
      </div>
    </main>
  </body>

  <script>
    document.addEventListener('astro:page-load', () => {
      document.getElementById('back-btn')?.addEventListener('click', () => history.back());
    });
  </script>

</html>
